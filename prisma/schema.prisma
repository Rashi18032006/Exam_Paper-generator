// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("PROFESSOR")
  createdAt    DateTime      @default(now())
  examSessions ExamSession[]
}

model ExamSession {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  topic        String
  totalMarks   Int
  numQuestions Int         @default(10)
  difficulty   String
  status       String      // 'GENERATING' | 'AWAITING_REVIEW' | 'APPROVED' | 'REJECTED'
  iteration    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  examDrafts   ExamDraft[]
}

model ExamDraft {
  id                String      @id @default(cuid())
  sessionId         String
  examSession       ExamSession @relation(fields: [sessionId], references: [id])
  draftJson         String
  professorFeedback String?
  createdAt         DateTime    @default(now())
}
